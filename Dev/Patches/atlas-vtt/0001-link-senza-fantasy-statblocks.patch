+describe('StatblockLinkModal without Fantasy Statblocks', () => {
+  it("lists the vault's statblock notes and links one", async () => {
+    const { TFile } = await import('obsidian');
+    const notes: Record<string, string> = {
+      'Notes/Vecna.md': ['```statblock', 'name: Vecna', 'size: Large', 'type: Undead', 'cr: 5', '```'].join('\n'),
+      'SRD/Goblin Warrior.md': ['---', 'statblock: true', 'name: Goblin Warrior', 'hp: 10', '---'].join('\n'),
+      'Notes/Goblins.md': '# Goblins\n\nA note about goblins, without a statblock.',
+    };
+    const files = Object.keys(notes).map((path) => new TFile(path));
+    const frontmatter: Record<string, Record<string, unknown>> = {
+      'SRD/Goblin Warrior.md': { statblock: true, name: 'Goblin Warrior', hp: 10 },
+    };
+    const app = {
+      workspace: { on: () => ({}), offref: () => undefined },
+      vault: {
+        getMarkdownFiles: () => files,
+        getAbstractFileByPath: (path: string) => files.find((file) => file.path === path) ?? null,
+        cachedRead: (file: { path: string }) => Promise.resolve(notes[file.path] ?? ''),
+      },
+      metadataCache: {
+        getFileCache: (file: { path: string }) => ({ frontmatter: frontmatter[file.path] }),
+        getFirstLinkpathDest: () => null,
+      },
+    } as never;
+    const onLink = vi.fn();
+
+    render(<StatblockLinkModal isOpen onClose={vi.fn()} asset={{ name: 'Token' }} onLink={onLink} app={app} />);
+
+    expect(await screen.findByText('Goblin Warrior')).toBeTruthy();
+    expect(optionNames()).toEqual(['Goblin Warrior', 'Vecna']);
+    expect(search().disabled).toBe(false);
+    fireEvent.keyDown(search(), { key: 'Enter' });
+    expect(onLink).toHaveBeenCalledWith('SRD/Goblin Warrior.md');
+  });
+});
+
 describe('StatblockLinkModal while the bestiary parses', () => {
   afterEach(() => { vi.useRealTimers(); });
 
