+it('takes name and hit points from a statblock note without Fantasy Statblocks', async () => {
+  const notePath = 'SRD/Goblin Warrior.md';
+  const mapPath = 'atlas-vtt/collections/Own/scenes/Cave.atlasmap';
+  const goblin = { id: 't1', kind: 'character', imagePath: 'goblin.webp', x: 0, y: 0, name: 'goblin' };
+  const scene = JSON.stringify({ version: 4, state: { version: 4, objects: { tokens: { t1: goblin } } } });
+  const { app, files } = createInMemoryApp({
+    files: { [notePath]: '---\nstatblock: true\nname: Goblin Warrior\nhp: 10\n---\n', [mapPath]: scene },
+  });
+  app.vault.cachedRead = app.vault.read;
+  // Obsidian's metadata cache, which the in-memory vault leaves empty.
+  const frontmatter = { statblock: true, name: 'Goblin Warrior', hp: 10 };
+  app.metadataCache.getFileCache = ((file: { path: string }) => (file.path === notePath ? { frontmatter } : null)) as never;
+  const assetService = { getCollectionForMap: () => 'Own', getCollectionSettings: () => ({ conditions: [], resources: DEFINITIONS }) };
+  const service = Object.assign(Object.create(TokenStatblockLinkService.prototype), { app, assetService });
+  await service.updateAllSpawnedTokens('goblin.webp', notePath);
+  const token = JSON.parse(files.get(mapPath)!).state.objects.tokens.t1;
+  expect(token).toMatchObject({ name: 'Goblin Warrior', statblockPath: notePath, hp: { current: 10, max: 10 } });
+});
+
 describe('linking a statblock to the tokens of closed maps', () => {
